<Window x:Class="Projekt.Forms.NoteEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="NoteForge – Editor"
        Height="600" Width="900"
        MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        KeyDown="Window_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="Markdown">
                <MenuItem Header="Podebljano (Ctrl+B)" Click="MenuBold_Click"/>
                <MenuItem Header="Kurziv" Click="MenuItalic_Click"/>
                <MenuItem Header="Naslov 1" Click="MenuH1_Click"/>
                <MenuItem Header="Naslov 2" Click="MenuH2_Click"/>
                <MenuItem Header="Lista" Click="MenuList_Click"/>
                <MenuItem Header="Kod" Click="MenuCode_Click"/>
            </MenuItem>
        </Menu>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="8">
            <Label Content="Naslov:"/>
            <TextBox x:Name="txtTitle" Width="300" Margin="4,0"/>
            <Label Content="Tip:" Margin="8,0,0,0"/>
            <ComboBox x:Name="cmbType" Width="120" Margin="4,0">
                <ComboBoxItem>Personal</ComboBoxItem>
                <ComboBoxItem>Work</ComboBoxItem>
                <ComboBoxItem>Study</ComboBoxItem>
                <ComboBoxItem>Idea</ComboBoxItem>
                <ComboBoxItem>Project</ComboBoxItem>
            </ComboBox>
            <Label Content="Tagovi:" Margin="8,0,0,0"/>
            <TextBox x:Name="txtTags" Width="200" Margin="4,0"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <Label DockPanel.Dock="Top" Content="Markdown"/>
                <TextBox x:Name="txtEditor"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="13"
                         TextWrapping="Wrap"
                         TextChanged="txtEditor_TextChanged"/>
            </DockPanel>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="LightGray"/>

            <DockPanel Grid.Column="2">
                <Label DockPanel.Dock="Top" Content="Preview"/>
                <wv2:WebView2 x:Name="webPreview"/>
            </DockPanel>
        </Grid>

        <DockPanel Grid.Row="3" Margin="8">
            <TextBlock x:Name="txtLastSaved" Text="Nije još spremljeno"
               DockPanel.Dock="Left" VerticalAlignment="Center" Margin="10,5"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                DockPanel.Dock="Right">
                <Button x:Name="btnSave" Content="Spremi"
                Width="100" Margin="4" Click="btnSave_Click"/>
                <Button x:Name="btnCancel" Content="Odustani"
                Width="100" Margin="4" Click="btnCancel_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
